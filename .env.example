# ==============================================================================
# 알약이가 (e-Drug Care) 환경변수 템플릿 (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 발급받은 키를 입력하세요.
# ==============================================================================

DJANGO_SECRET_KEY="your-django-secret-key-here"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost"

PUBLIC_DATA_API_KEY="your-decoded-api-key"
PUBLIC_DATA_API_ENCODED_KEY="your-url-encoded-api-key"
PUBLIC_DATA_API_DECODED_KEY="your-decoded-api-key"

MFDS_GRAIN_API_KEY="your-url-encoded-api-key"
MFDS_GRAIN_END_POINT="https://apis.data.go.kr/1471000/MdcinGrnIdntfcInfoService03"

MFDS_PERMISSION_API_KEY="your-url-encoded-api-key"
MFDS_PERMISSION_END_POINT="https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService08"

MFDS_EASY_DRUG_API_KEY="your-url-encoded-api-key"
MFDS_EASY_DRUG_END_POINT="https://apis.data.go.kr/1471000/DrbEasyDrugInfoService"
